{
    "PrimeVue CRUD List": {
        "prefix": "pv-list",
        "body": [
            "<script setup>",
            "import { ref, onMounted } from 'vue'",
            "import { use${1:User}Crud } from '@/composables/${2:user}/crud'",
            "import { useToast } from 'primevue/usetoast'",
            "",
            "const toast = useToast()",
            "const {",
            "  list,",
            "  fetchList,",
            "  loading,",
            "} = use$1Crud()",
            "",
            "// Delete dialog state",
            "const deletingData = ref(null)",
            "const deleteDialogVisible = ref(false)",
            "",
            "const openDelete = (row) => {",
            "  deletingData.value = row",
            "  deleteDialogVisible.value = true",
            "}",
            "",
            "onMounted(() => {",
            "  fetchList()",
            "})",
            "</script>",
            "",
            "<template>",
            "  <div class=\"p-4 space-y-4\">",
            "",
            "    <div class=\"flex justify-between items-center\">",
            "      <h2 class=\"text-xl font-semibold\">${1:User} List</h2>",
            "      <RouterLink",
            "        :to=\"{ name: '${3:user}-create' }\"",
            "        class=\"px-3 py-2 rounded-lg bg-primary text-white hover:bg-primary-600 transition\"",
            "      >",
            "        Create ${1:User}",
            "      </RouterLink>",
            "    </div>",
            "",
            "    <DataTable",
            "      :value=\"list\"",
            "      :loading=\"loading\"",
            "      dataKey=\"id\"",
            "      class=\"rounded-lg shadow-md\"",
            "    >",
            "",
            "      <Column field=\"id\" header=\"ID\" style=\"width: 80px\" />",
            "      <Column field=\"name\" header=\"Name\" />",
            "",
            "      <Column header=\"Actions\" style=\"width: 150px\">",
            "        <template #body=\"{ data }\">",
            "          <div class=\"flex items-center gap-2\">",
            "            <RouterLink",
            "              :to=\"{ name: '${3:user}-edit', params: { id: data.id } }\"",
            "              class=\"px-2 py-1 rounded bg-blue-500 text-white hover:bg-blue-600 text-xs\"",
            "            >",
            "              Edit",
            "            </RouterLink>",
            "",
            "            <button",
            "              @click=\"openDelete(data)\"",
            "              class=\"px-2 py-1 rounded bg-red-500 text-white hover:bg-red-600 text-xs\"",
            "            >",
            "              Delete",
            "            </button>",
            "          </div>",
            "        </template>",
            "      </Column>",
            "",
            "    </DataTable>",
            "",
            "    <!-- Delete Dialog -->",
            "    <DeleteDialog",
            "      v-if=\"deleteDialogVisible\"",
            "      v-model:visible=\"deleteDialogVisible\"",
            "      :data=\"deletingData\"",
            "      crud=\"${1:User}\"",
            "      @success=\"fetchList()\"",
            "    />",
            "",
            "  </div>",
            "</template>",
            "",
            "<style scoped></style>"
        ],
        "description": "PrimeVue CRUD List Page Template with Composition API & Composables"
    }
}
