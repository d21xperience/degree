{
    "CRUD Edit View": {
        "prefix": "pv-edit",
        "body": [
            "<template>",
            "  <div class=\"p-4\">",
            "    <Card>",
            "      <template #title>",
            "        Edit ${1:title}",
            "      </template>",
            "",
            "      <template #content>",
            "        <div v-if=\"loading\" class=\"text-center py-10\">",
            "          <ProgressSpinner />",
            "        </div>",
            "",
            "        <div v-else>",
            "          <${1: title}Form",
            "            :initialData=\"${1: title}\"",
            "            @submit=\"update${1: title}\"",
            "          />",
            "        </div>",
            "      </template>",
            "",
            "      <template #footer>",
            "        <Button",
            "          label=\"Kembali\"",
            "          severity=\"secondary\"",
            "          @click=\"goBack\"",
            "        />",
            "      </template>",
            "    </Card>",
            "  </div>",
            "</template>",
            "",
            "<script setup>",
            "import { ref, onMounted } from 'vue'",
            "import { useRoute, useRouter } from 'vue-router'",
            "",
            "",
            "// Custom composable CRUD",
            "import { use${1: title}sCrud } from '@/composables/use${1: title}sCrud'",
            "",
            "// External component (form)",
            "import ${1: title}Form from '@/components/${1: title}/${1: title}Form.vue'",
            "",
            "const route = useRoute()",
            "const router = useRouter()",
            "",
            "const { getById, update } = use${1: title}sCrud()",
            "",
            "const ${1: title} = ref(null)",
            "const loading = ref(true)",
            "",
            "onMounted(async () => {",
            "  const id = route.params.id",
            "  ${1: title}.value = await getById(id)",
            "  loading.value = false",
            "})",
            "",
            "const update${1: title} = async (data) => {",
            "  await update(route.params.id, data)",
            "  router.push({ name: '${1: title}.list' })",
            "}",
            "",
            "const goBack = () => {",
            "  router.push({ name: '${1: title}.list' })",
            "}",
            "</script>",
            "",
            "<style scoped>",
            "</style>"
        ],
        "description": "Halaman Edit CRUD menggunakan PrimeVue 4 + Tailwind + Composition API + Composable"
    }
}
