{
  "PrimeVue 4 CRUD Template (Tailwind + DataTable)": {
    "prefix": "pv-crud",
    "description": "Full CRUD template using PrimeVue 4 DataTable, Dialog, Toast, ConfirmPopup + Tailwind CSS",
    "body": [
      "<template>",
      "  <div class=\"p-4 md:p-6\">",
      "    <Toast />",
      "",
      "    <!-- Header -->",
      "    <div class=\"mb-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4\">",
      "      <h2 class=\"text-2xl font-bold text-gray-800 dark:text-white\">Manage ${1:Items}</h2>",
      "      <Button",
      "        icon=\"pi pi-plus\"",
      "        label=\"Add ${1:Item}\"",
      "        @click=\"openCreateDialog\"",
      "        class=\"p-button-primary\"",
      "      />",
      "    </div>",
      "",
      "    <!-- DataTable -->",
      "    <Card>",
      "      <template #content>",
      "        <DataTable",
      "          v-model:selection=\"selectedItems\"",
      "          :value=\"${2:items}\"",
      "          :loading=\"loading\"",
      "          paginator",
      "          :rows=\"10\"",
      "          :rowsPerPageOptions=\"[5, 10, 20]\"",
      "          dataKey=\"id\"",
      "          responsiveLayout=\"scroll\"",
      "          selectionMode=\"multiple\"",
      "          class=\"p-datatable-sm\"",
      "        >",
      "          <template #header>",
      "            <div class=\"flex flex-col sm:flex-row justify-between gap-3\">",
      "              <h5 class=\"font-semibold text-gray-700 dark:text-gray-300\">${1:Items} List</h5>",
      "              <div class=\"flex gap-2\">",
      "                <span class=\"self-center text-sm text-gray-500\">",
      "                  {{ selectedItems.length }} selected",
      "                </span>",
      "                <Button",
      "                  v-if=\"selectedItems.length\"",
      "                  type=\"button\"",
      "                  icon=\"pi pi-trash\"",
      "                  severity=\"danger\"",
      "                  outlined",
      "                  @click=\"confirmDeleteSelected\"",
      "                  class=\"p-button-sm\"",
      "                />",
      "                <IconField>",
      "                  <InputIcon class=\"pi pi-search\" />",
      "                  <InputText",
      "                    v-model=\"filters.global.value\"",
      "                    placeholder=\"Search...\"",
      "                    class=\"w-full sm:w-64\"",
      "                  />",
      "                </IconField>",
      "              </div>",
      "            </div>",
      "          </template>",
      "",
      "          <Column selectionMode=\"multiple\" style=\"width: 3rem\" />",
      "",
      "          <Column field=\"id\" header=\"ID\" sortable style=\"width: 6rem\" />",
      "",
      "          <Column field=\"name\" header=\"Name\" sortable>",
      "            <template #body=\"{ data }\">",
      "              <span class=\"font-medium\">{{ data.name }}</span>",
      "            </template>",
      "          </Column>",
      "",
      "          <Column field=\"email\" header=\"Email\" sortable class=\"hidden md:table-cell\" />",
      "",
      "          <Column field=\"status\" header=\"Status\" sortable>",
      "            <template #body=\"{ data }\">",
      "              <Tag",
      "                :value=\"data.status\"",
      "                :severity=\"getStatusSeverity(data.status)\"",
      "                class=\"text-xs px-2 py-1\"",
      "              />",
      "            </template>",
      "          </Column>",
      "",
      "          <Column header=\"Actions\" style=\"width: 10rem\">",
      "            <template #body=\"{ data }\">",
      "              <div class=\"flex gap-2\">",
      "                <Button",
      "                  icon=\"pi pi-pencil\"",
      "                  rounded",
      "                  text",
      "                  @click=\"openEditDialog(data)\"",
      "                  class=\"text-blue-600 hover:bg-blue-50 dark:hover:bg-gray-700\"",
      "                />",
      "                <Button",
      "                  icon=\"pi pi-trash\"",
      "                  rounded",
      "                  text",
      "                  severity=\"danger\"",
      "                  @click=\"confirmDelete(data)\"",
      "                  class=\"text-red-600 hover:bg-red-50 dark:hover:bg-gray-700\"",
      "                />",
      "              </div>",
      "            </template>",
      "          </Column>",
      "",
      "          <template #empty>",
      "            <div class=\"py-8 text-center\">",
      "              <i class=\"pi pi-inbox text-3xl text-gray-400 mb-3\"></i>",
      "              <p class=\"text-gray-500 dark:text-gray-400\">No ${2:items} found.</p>",
      "            </div>",
      "          </template>",
      "",
      "          <template #loading>",
      "            <div class=\"py-8 text-center\">",
      "              <i class=\"pi pi-spinner pi-spin text-3xl text-blue-500\"></i>",
      "              <p class=\"mt-2 text-gray-500\">Loading data...</p>",
      "            </div>",
      "          </template>",
      "        </DataTable>",
      "      </template>",
      "    </Card>",
      "  </div>",
      "",
      "  <!-- Create/Edit Dialog -->",
      "  <Dialog",
      "    v-model:visible=\"dialogVisible\"",
      "    :header=\"editingItem ? 'Edit ${1:Item}' : 'Add New ${1:Item}'\"",
      "    :modal=\"true\"",
      "    :style=\"{ width: '32rem' }\"",
      "    @hide=\"resetForm\"",
      "  >",
      "    <form @submit.prevent=\"onSubmit\">",
      "      <div class=\"grid gap-4\">",
      "        <div class=\"flex flex-col gap-2\">",
      "          <label for=\"name\" class=\"font-medium text-gray-700 dark:text-gray-300\">Name *</label>",
      "          <InputText",
      "            id=\"name\"",
      "            v-model=\"form.name\"",
      "            :class=\"{ 'p-invalid': formErrors.name }\"",
      "            autofocus",
      "          />",
      "          <small v-if=\"formErrors.name\" class=\"p-error\">{{ formErrors.name }}</small>",
      "        </div>",
      "",
      "        <div class=\"flex flex-col gap-2\">",
      "          <label for=\"email\" class=\"font-medium text-gray-700 dark:text-gray-300\">Email *</label>",
      "          <InputText",
      "            id=\"email\"",
      "            v-model=\"form.email\"",
      "            type=\"email\"",
      "            :class=\"{ 'p-invalid': formErrors.email }\"",
      "          />",
      "          <small v-if=\"formErrors.email\" class=\"p-error\">{{ formErrors.email }}</small>",
      "        </div>",
      "",
      "        <div class=\"flex flex-col gap-2\">",
      "          <label class=\"font-medium text-gray-700 dark:text-gray-300\">Status</label>",
      "          <Select",
      "            v-model=\"form.status\"",
      "            :options=\"statusOptions\"",
      "            optionLabel=\"label\"",
      "            optionValue=\"value\"",
      "            placeholder=\"Select status\"",
      "          />",
      "        </div>",
      "      </div>",
      "",
      "      <div class=\"flex justify-end gap-3 mt-6\">",
      "        <Button",
      "          type=\"button\"",
      "          label=\"Cancel\"",
      "          @click=\"dialogVisible = false\"",
      "          severity=\"secondary\"",
      "        />",
      "        <Button",
      "          type=\"submit\"",
      "          :label=\"editingItem ? 'Update' : 'Save'\"",
      "          :loading=\"submitting\"",
      "          :disabled=\"submitting\"",
      "        />",
      "      </div>",
      "    </form>",
      "  </Dialog>",
      "",
      "  <!-- Delete Confirmation -->",
      "  <ConfirmPopup />",
      "</template>",
      "",
      "<script setup>",
      "import { ref, reactive, onMounted } from 'vue';",
      "import { useToast } from 'primevue/usetoast';",
      "import { useConfirm } from 'primevue/useconfirm';",
      "import { FilterMatchMode } from 'primevue/api';",
      "// import { use${3:Items} } from '@/composables/use${3:Items}';",
      "",
      "// Jika tidak pakai composable, uncomment block berikut:",
      "/*",
      "const ${2:items} = ref([]);",
      "const loading = ref(false);",
      "",
      "const fetch${3:Items} = async () => {",
      "  loading.value = true;",
      "  try {",
      "    // TODO: Ganti dengan API sebenarnya",
      "    await new Promise(r => setTimeout(r, 500));",
      "    ${2:items}.value = Array.from({ length: 8 }, (_, i) => ({",
      "      id: i + 1,",
      "      name: `${1:Item} ${i + 1}`,",
      "      email: `${1:Item.toLowerCase()}${i + 1}@example.com`,",
      "      status: i % 3 === 0 ? 'inactive' : i % 3 === 1 ? 'pending' : 'active',",
      "    }));",
      "  } finally {",
      "    loading.value = false;",
      "  }",
      "};",
      "*/",
      "",
      "const toast = useToast();",
      "const confirm = useConfirm();",
      "",
      "// const { ${2:items}, loading, fetch${3:Items}, create${3:Item}, update${3:Item}, delete${3:Item}, delete${3:Items} } = use${3:Items}();",
      "",
      "const selectedItems = ref([]);",
      "const dialogVisible = ref(false);",
      "const editingItem = ref(null);",
      "const submitting = ref(false);",
      "",
      "const form = reactive({",
      "  name: '',",
      "  email: '',",
      "  status: 'active',",
      "});",
      "",
      "const formErrors = reactive({",
      "  name: '',",
      "  email: '',",
      "});",
      "",
      "const filters = reactive({",
      "  global: { value: null, matchMode: FilterMatchMode.CONTAINS }",
      "});",
      "",
      "const statusOptions = [",
      "  { label: 'Active', value: 'active' },",
      "  { label: 'Pending', value: 'pending' },",
      "  { label: 'Inactive', value: 'inactive' },",
      "];",
      "",
      "onMounted(() => {",
      "  // fetch${3:Items}();",
      "});",
      "",
      "// --- Dialog & Form ---",
      "const openCreateDialog = () => {",
      "  editingItem.value = null;",
      "  Object.assign(form, { name: '', email: '', status: 'active' });",
      "  Object.assign(formErrors, { name: '', email: '' });",
      "  dialogVisible.value = true;",
      "};",
      "",
      "const openEditDialog = (item) => {",
      "  editingItem.value = item;",
      "  Object.assign(form, { ...item });",
      "  Object.assign(formErrors, { name: '', email: '' });",
      "  dialogVisible.value = true;",
      "};",
      "",
      "const validateForm = () => {",
      "  formErrors.name = !form.name ? 'Name is required' : '';",
      "  formErrors.email = !form.email ? 'Email is required' : !/^\\\\S+@\\\\S+\\\\.\\\\S+$/.test(form.email) ? 'Invalid email' : '';",
      "  return !formErrors.name && !formErrors.email;",
      "};",
      "",
      "const onSubmit = async () => {",
      "  if (!validateForm()) return;",
      "",
      "  submitting.value = true;",
      "  try {",
      "    if (editingItem.value) {",
      "      // await update${3:Item}(editingItem.value.id, form);",
      "      toast.add({ severity: 'success', summary: 'Success', detail: '${1:Item} updated', life: 3000 });",
      "    } else {",
      "      // await create${3:Item}(form);",
      "      toast.add({ severity: 'success', summary: 'Success', detail: '${1:Item} created', life: 3000 });",
      "    }",
      "    dialogVisible.value = false;",
      "    // await fetch${3:Items}();",
      "  } catch (err) {",
      "    toast.add({ severity: 'error', summary: 'Error', detail: err.message || 'Operation failed', life: 5000 });",
      "  } finally {",
      "    submitting.value = false;",
      "  }",
      "};",
      "",
      "const resetForm = () => {",
      "  editingItem.value = null;",
      "  Object.assign(form, { name: '', email: '', status: 'active' });",
      "  Object.assign(formErrors, { name: '', email: '' });",
      "};",
      "",
      "// --- Delete ---",
      "const confirmDelete = (item) => {",
      "  confirm.require({",
      "    message: `Are you sure you want to delete \"${'$'}{item.name}\"?`,",
      "    header: 'Confirmation',",
      "    icon: 'pi pi-exclamation-triangle',",
      "    accept: () => deleteItemHandler(item),",
      "  });",
      "};",
      "",
      "const confirmDeleteSelected = () => {",
      "  confirm.require({",
      "    message: `Delete ${'$'}{selectedItems.value.length} selected items?`,",
      "    header: 'Confirmation',",
      "    icon: 'pi pi-exclamation-triangle',",
      "    accept: () => deleteSelectedHandler(),",
      "  });",
      "};",
      "",
      "const deleteItemHandler = async (item) => {",
      "  try {",
      "    // await delete${3:Item}(item.id);",
      "    toast.add({ severity: 'success', summary: 'Deleted', detail: `${'$'}{item.name} removed`, life: 3000 });",
      "    selectedItems.value = selectedItems.value.filter(i => i.id !== item.id);",
      "  } catch (err) {",
      "    toast.add({ severity: 'error', summary: 'Error', detail: 'Failed to delete item', life: 5000 });",
      "  }",
      "};",
      "",
      "const deleteSelectedHandler = async () => {",
      "  const ids = selectedItems.value.map(i => i.id);",
      "  try {",
      "    // await delete${3:Items}(ids);",
      "    toast.add({ severity: 'success', summary: 'Deleted', detail: `${'$'}{ids.length} items removed`, life: 3000 });",
      "    selectedItems.value = [];",
      "  } catch (err) {",
      "    toast.add({ severity: 'error', summary: 'Error', detail: 'Failed to delete items', life: 5000 });",
      "  }",
      "};",
      "",
      "// --- Helpers ---",
      "const getStatusSeverity = (status) => {",
      "  switch (status) {",
      "    case 'active': return 'success';",
      "    case 'pending': return 'warning';",
      "    case 'inactive': return 'danger';",
      "    default: return null;",
      "  }",
      "};",
      "</script>",
      "",
      "<style scoped>",
      "/* Opsional: Tailwind + PrimeVue harmony */",
      ":deep(.p-datatable .p-sortable-column) {",
      "  @apply font-medium;",
      "}",
      ":deep(.p-inputtext) {",
      "  @apply w-full;",
      "}",
      "</style>"
    ],
    "scope": "vue,typescript,vue-html"
  }
}